{
  "name": "dailytoolbox",
  "main": "worker.js",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/worldcup", "/worldcup.html", "/balance-game", "/balance-game.html"]
  },
  "kv_namespaces": [
    {
      "binding": "WORLDCUP_KV",
      "id": "40d9b75cbf704d93ad53030f6f225439"
    }
  ]
}
